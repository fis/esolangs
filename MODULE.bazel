module(name = "esolangs")

# bracket is not in any registry, so it's up to you to set up a suitable override
bazel_dep(name = "bracket")
local_path_override(module_name = "bracket", path = "../bracket")
bazel_dep(name = "bracket-protos")
local_path_override(module_name = "bracket-protos", path = "../bracket-protos")

bazel_dep(name = "civetweb", version = "1.16.bcr.3")
bazel_dep(name = "googletest", version = "1.17.0.bcr.1")
bazel_dep(name = "cpp-httplib", version = "0.22.0")
bazel_dep(name = "prometheus-cpp", version = "1.3.0.bcr.2")
bazel_dep(name = "protobuf", version = "33.0-rc2")  # TODO: non-RC version?
bazel_dep(name = "re2", version = "2025-08-12")
bazel_dep(name = "rules_proto", version = "7.1.0")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
archive_override(
    module_name = "hedron_compile_commands",
    patch_strip = 1,
    patches = ["//tools:compile-commands-extractor.patch"],
    sha256 = "ec1e419358eb23daeab0dd0206dfc930316bac9de942d94eb82019f402022847",
    strip_prefix = "bazel-compile-commands-extractor-abb61a688167623088f8768cc9264798df6a9d10",
    urls = ["https://github.com/hedronvision/bazel-compile-commands-extractor/archive/abb61a688167623088f8768cc9264798df6a9d10.zip"],
)

esolangs_non_module_dependencies = use_extension("@esolangs//:extensions.bzl", "non_module_dependencies")
use_repo(
    esolangs_non_module_dependencies,
    "closure_compiler_prebuilt",
)
